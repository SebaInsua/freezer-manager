# PostgreSQL
POSTGRES_DB=freezer_manager
POSTGRES_USER=freezer_user
POSTGRES_PASSWORD=change_me

# Spring Boot
DB_USERNAME=freezer_user
DB_PASSWORD=change_me
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/freezer_manager
SPRING_PROFILES_ACTIVE=docker

# JWT
# Replace with a secure Base64-encoded secret generated locally.
JWT_SECRET=replace_with_a_valid_base64_secret